  "global_decision_principles": {
    "bootstrap_behavior": "uniform over the exact set of xy coordinates observed so far",
    "aligned_acquisition_behavior": "frozen hub controller under an all-negative consequence stream",
    "aligned_return_behavior": "frozen supplied-goal router to a uniformly sampled occupied-sigma-cell support anchor",
    "ensemble_reduction": "minimum member value",
    "bridge_outcome_integration": "all joint mixture-component means weighted by their probabilities",
    "goal_location_prior": "equal mass per occupied landing-scale cell of unique recorded support",
    "latent_radius_prior": "log-uniform on [landing sigma, exact support diameter]",
    "hub_bank": "one recorded node per occupied landing-scale cell",
    "hub_choice": "exact global argmax of posterior contact coverage times corrected finite-horizon reachability",
    "link_outcome": "arrived within landing sigma of the selected graph destination",
    "link_kernel": "continuous Gaussian over source, command, and destination, each scaled by landing sigma",
    "route_outcome": "arrived within landing sigma of the selected hub before the attempt horizon expired",
    "route_kernel": "continuous two-sided Mahalanobis Gaussian using the empirical reach covariance for both source and hub",
    "route_horizon_transfer": "evidence transfers only at the exact remaining-command horizon",
    "online_posterior": "one offline prediction counted as one prior observation plus continuously weighted online outcomes",
    "online_memory_scope": "one task across physical resets; reset between tasks",
    "return_controller": "frozen supplied-goal return planner with destination-arrival link correction only",
    "cutoffs": {
      "link_similarity": null,
      "route_similarity": null,
      "hub_evaluation": null,
      "movement_request": null,
      "wall_crossing": null
    }
  },
  "data_derived_rules": {
    "landing_sigma": "held-out ensemble-and-mixture-weighted within-mode radial spatial spread of the deployed consequence model",
    "reach_weight": "(1-exp(-||command-start||^2/(2 sigma^2)))*(1-exp(-||endpoint-start||^2/(2 sigma^2)))",
    "reach_covariance": "weighted central second moment of realized one-command displacement",
    "rho_min": "landing sigma",
    "rho_max": "exact Euclidean diameter of unique recorded xy support",
    "planning_horizon": "H = T / tau, requiring exact divisibility",
    "state_scale": "landing sigma for xy and reward-free training standard deviation for remaining state",
    "alias_and_advance": "continuous Gaussian similarity at landing sigma; advance is one minus similarity"
  },
